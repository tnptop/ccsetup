# Ghostty config. Docs: https://ghostty.org/docs/config
# Reload without restart: cmd+shift+, (or Ghostty > Reload Configuration)

# --- font -----------------------------------------------------------------
# Monaspace (brew install --cask font-monaspace). Argon matches the work editor.
# All five variants (Neon, Argon, Xenon, Radon, Krypton) share metrics, so
# Radon (handwriting) serves as the italic face. Ligatures are stylistic sets,
# off by default; ss01-ss09 + liga turn them on. Texture healing (calt) is on.
font-family = "Monaspace Argon"
font-family-italic = "Monaspace Radon"
font-family-bold-italic = "Monaspace Radon"
font-feature = ss01, ss02, ss03, ss04, ss05, ss06, ss07, ss08, ss09, liga
font-size = 14
font-thicken = true

# --- theme ----------------------------------------------------------------
# Follows macOS light/dark. List options with: ghostty +list-themes
# theme = light:Catppuccin Latte,dark:Catppuccin Mocha
theme = opencode


# --- window ---------------------------------------------------------------
window-padding-x = 10
window-padding-y = 8
window-padding-balance = true
macos-titlebar-style = transparent
window-save-state = always

# --- cursor / mouse -------------------------------------------------------
cursor-style = block
cursor-style-blink = false
mouse-hide-while-typing = true
copy-on-select = clipboard

# --- shell ----------------------------------------------------------------
# Shell integration for zsh is injected automatically; this adds the extras.
shell-integration = zsh
shell-integration-features = cursor,sudo,title

# --- keybinds -------------------------------------------------------------
# Option key sends Meta so alt+b / alt+f word-jumps work in zsh.
macos-option-as-alt = true
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+alt+left=goto_split:left
keybind = cmd+alt+right=goto_split:right
keybind = cmd+alt+up=goto_split:up
keybind = cmd+alt+down=goto_split:down
keybind = cmd+shift+enter=toggle_split_zoom