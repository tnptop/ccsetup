{
  "permissions": {
    "deny": [
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git branch -D:*)",
      "Bash(git checkout .)",
      "Bash(git checkout . *)",
      "Bash(git restore .)",
      "Bash(git restore . *)"
    ],
    "defaultMode": "auto"
  },
  "model": "fable[1m]",
  "skillOverrides": {
    "ask-matt": "off",
    "claude-handoff": "off",
    "decision-mapping": "off",
    "design-an-interface": "off",
    "diagnosing-bugs": "off",
    "domain-modeling": "off",
    "edit-article": "off",
    "find-skills": "off",
    "implement": "off",
    "loop-me": "off",
    "migrate-to-shoehorn": "off",
    "obsidian-vault": "off",
    "prototype": "off",
    "qa": "off",
    "request-refactor-plan": "off",
    "research": "off",
    "resolving-merge-conflicts": "off",
    "review": "off",
    "scaffold-exercises": "off",
    "setup-pre-commit": "off",
    "tdd": "off",
    "triage": "off",
    "ubiquitous-language": "off",
    "wizard": "off",
    "writing-beats": "off",
    "writing-fragments": "off",
    "writing-great-skills": "off",
    "writing-shape": "off",
    "to-spec": "off",
    "to-tickets": "off",
    "wayfinder": "off",
    "grill-me": "off",
    "grill-with-docs": "off",
    "setup-matt-pocock-skills": "off",
    "improve": "off",
    "built-in-browser": "off",
    "chrome-browser": "off",
    "computer-use": "off",
    "anthropic-skills:deep-research": "off",
    "docs": "off",
    "docx": "off",
    "import-memory": "off",
    "morning": "off",
    "pdf": "off",
    "pptx": "off",
    "skill-creator": "off",
    "xlsx": "off",
    "dataviz": "off",
    "claude-api": "off",
    "artifact-capabilities": "off",
    "update-config": "off",
    "keybindings-help": "off",
    "schedule": "off",
    "loop": "off",
    "claude-in-chrome": "off",
    "run": "off",
    "archify": "off",
    "codebase-design": "off",
    "improve-codebase-architecture": "off",
    "teach": "off",
    "git-guardrails-claude-code": "off",
    "handoff": "off",
    "show-me": "off"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/block-dangerous-git.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/task-anchor.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/keep-display-awake.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "code-review@claude-plugins-official": false,
    "figma@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": false,
    "codex@openai-codex": true,
    "warp@claude-code-warp": false
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "claude-code-warp": {
      "source": {
        "source": "github",
        "repo": "warpdotdev/claude-code-warp"
      }
    }
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "autoCompactEnabled": false,
  "agentPushNotifEnabled": true,
  "autoMode": {
    "environment": [
      "### Org-wide",
      "**Organization**: None configured",
      "**Cloud provider(s)**: None configured",
      "**Repository visibility**: assume private unless the remote host and repo name indicate otherwise, or a visibility check in the transcript shows public",
      "**Internal sharing / snippet hosting**: None configured — treat public paste/gist services as outside the trust boundary",
      "**Secrets management**: None configured",
      "**Default / protected branches**: unknown — origin/HEAD unset, no remotes configured",
      "**CI/CD deploy targets**: None configured",
      "**Network posture**: None configured",
      "**Host containment**: None configured — assume Claude Code runs on an ordinary developer machine or CI runner with open internet",
      "**Source control**: The trusted repo (/Users/tnptop/workspace/personal) only — no remotes configured, no additional orgs configured",
      "**Trusted internal domains**: None configured",
      "**Trusted cloud buckets**: None configured",
      "**Key internal services**: None configured",
      "**Internal package registry**: None configured",
      "**Sensitive data locations & audiences**: any file or store holding personal data, confidential business data, credentials, regulated data, or similarly sensitive material; preserve exact handles when known and share only with audiences cleared at the [named+specifics] bar",
      "**Data retention / declassification**: None configured",
      "**Sensitive remote targets**: any namespace, host, or container whose name carries `prod` or `production` as a whole word or name segment (hyphen/underscore/dot-delimited — e.g. matches `prod-db`, not `producer`)",
      "**Protected deployment namespaces / environments**: None configured — fall back to the Sensitive remote targets heuristic",
      "**Protected IaC scopes**: IAM, RBAC, networking, quota, and node-pool resources; anything whose name or tag carries `prod` or `production` as a whole word or name segment",
      "### User-specific",
      "**Primary use of Claude Code**: software development (personal/hobby project, no tracked files yet)",
      "**Trusted repo**: /Users/tnptop/workspace/personal — no remotes configured; treat as an untracked, empty local repo until a remote is added",
      "**Org-specific CLIs**: None configured"
    ]
  }
}
