{
  "permissions": {
    "deny": [
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git branch -D:*)",
      "Bash(git checkout .)",
      "Bash(git checkout . *)",
      "Bash(git restore .)",
      "Bash(git restore . *)"
    ],
    "defaultMode": "auto"
  },
  "model": "fable[1m]",
  "skillOverrides": {
    "ask-matt": "off",
    "claude-handoff": "off",
    "decision-mapping": "off",
    "design-an-interface": "off",
    "diagnosing-bugs": "off",
    "domain-modeling": "off",
    "edit-article": "off",
    "find-skills": "off",
    "implement": "off",
    "loop-me": "off",
    "migrate-to-shoehorn": "off",
    "obsidian-vault": "off",
    "prototype": "off",
    "qa": "off",
    "request-refactor-plan": "off",
    "research": "off",
    "resolving-merge-conflicts": "off",
    "review": "off",
    "scaffold-exercises": "off",
    "setup-pre-commit": "off",
    "tdd": "off",
    "triage": "off",
    "ubiquitous-language": "off",
    "wizard": "off",
    "writing-beats": "off",
    "writing-fragments": "off",
    "writing-great-skills": "off",
    "writing-shape": "off",
    "to-spec": "off",
    "to-tickets": "off",
    "wayfinder": "off",
    "grill-me": "off",
    "grill-with-docs": "off",
    "setup-matt-pocock-skills": "off",
    "improve": "off",
    "built-in-browser": "off",
    "chrome-browser": "off",
    "computer-use": "off",
    "anthropic-skills:deep-research": "off",
    "docs": "off",
    "docx": "off",
    "import-memory": "off",
    "morning": "off",
    "pptx": "off",
    "skill-creator": "off",
    "xlsx": "off",
    "dataviz": "off",
    "artifact-capabilities": "off",
    "keybindings-help": "off",
    "schedule": "off",
    "loop": "off",
    "claude-in-chrome": "off",
    "run": "off",
    "archify": "off",
    "codebase-design": "off",
    "improve-codebase-architecture": "off",
    "teach": "off",
    "git-guardrails-claude-code": "off",
    "handoff": "off",
    "show-me": "off"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"C:\\Program Files\\Git\\bin\\bash.exe\" ~/.claude/hooks/block-dangerous-git.sh"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -File \"C:\\Users\\tgcru\\.claude\\hooks\\block-deletions.ps1\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"C:\\Program Files\\Git\\bin\\bash.exe\" ~/.claude/hooks/task-anchor.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "\"C:\\Program Files\\Git\\bin\\bash.exe\" ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "code-review@claude-plugins-official": false,
    "figma@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": false,
    "codex@openai-codex": true,
    "warp@claude-code-warp": true
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "claude-code-warp": {
      "source": {
        "source": "github",
        "repo": "warpdotdev/claude-code-warp"
      }
    }
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "autoCompactEnabled": false,
  "agentPushNotifEnabled": true
}
